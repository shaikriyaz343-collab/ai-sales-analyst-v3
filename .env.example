# AI Sales Analyst V4 local/staging/production configuration template
# Do not put real secrets in this file.

V4_ENVIRONMENT=development

# Comma-separated exact browser origins.
V4_FRONTEND_ORIGINS=http://localhost:3000

# Comma-separated API Host header allowlist.
V4_TRUSTED_HOSTS=localhost,127.0.0.1

# Keep false for local HTTP development. Must be true in production.
V4_AUTH_SECURE_COOKIE=false
V4_AUTH_COOKIE_NAME=v4_auth_session

# Runtime/storage roots. Production should set an explicit runtime root.
# V4_RUNTIME_ROOT=
# V4_AUTH_STORAGE=
# V4_DATA_STORAGE=

# Upload/caching limits.
V4_UPLOAD_MAX_BYTES=52428800
V4_CACHE_MAX_BYTES=5368709120

# Security response headers. Production must remain enabled.
V4_SECURITY_HEADERS_ENABLED=false
V4_HSTS_MAX_AGE=31536000

# Authentication abuse protection.
V4_AUTH_LOGIN_IP_LIMIT=20
V4_AUTH_LOGIN_EMAIL_LIMIT=8
V4_AUTH_LOGIN_WINDOW_SECONDS=900
V4_AUTH_SIGNUP_IP_LIMIT=10
V4_AUTH_SIGNUP_EMAIL_LIMIT=3
V4_AUTH_SIGNUP_WINDOW_SECONDS=3600
V4_AUTH_SESSION_IDLE_SECONDS=1800
V4_AUTH_SESSION_MAX_SECONDS=604800

# Runtime analysis capacity.
V4_ANALYTICS_CONCURRENCY=4

# External durable persistence.
V4_PERSISTENCE_MODE=local
# V4_DATABASE_URL=postgresql://user:password@db.example.com:5432/ai_sales_analyst
# V4_OBJECT_STORE_BUCKET=ai-sales-analyst-v4-prod
# V4_OBJECT_STORE_REGION=auto
# V4_OBJECT_STORE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# V4_OBJECT_STORE_ACCESS_KEY=
# V4_OBJECT_STORE_SECRET_KEY=
V4_OBJECT_STORE_PREFIX=v4
# V4_OBJECT_STORE_TEMP_ROOT=/srv/ai-sales-analyst/runtime_object_cache

# Commercial billing. Keep disabled until external Paddle activation is verified.
V4_BILLING_PROVIDER=disabled
V4_PADDLE_ENVIRONMENT=sandbox
# V4_PADDLE_API_KEY=
# V4_PADDLE_WEBHOOK_SECRET=
# V4_PADDLE_STARTER_PRICE_ID=
# V4_PADDLE_GROWTH_PRICE_ID=
# V4_BILLING_RECONCILIATION_TOKEN=
